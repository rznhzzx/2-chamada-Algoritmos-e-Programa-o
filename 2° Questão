#include <iostream>
using namespace std;

int main() {
    float notas[10];
    float soma=0,media;
    int acimaMedia=0;

    for(int i=0;i<10;i++) {
        cout<<"Digite a nota do aluno "<<i+1<<": ";
        cin>>notas[i];

        soma+=notas[i];
    }

    media=soma/10;

    for(int i=0;i<10;i++) {
        if(notas[i]>media) {
            acimaMedia++;
        }
    }

    cout<<"\nMedia da turma: "<<media<<endl;
    cout<<"Quantidade de alunos acima da media: "<<acimaMedia<<endl;

    return 0;
}
