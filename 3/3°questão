//Declare um vetor de 5 inteiros, leia um valor para cada posição e no final mostre quantos
//elementos possuem valor maior, menor e igual ao primeiro elemento do vetor.

#include <iostream>
using namespace std;

int main() {
    int vetor[5];
    int maior=0,menor=0,igual=0;

    for(int i=0;i<5;i++) {
        cout<<"Digite um valor: ";
        cin>>vetor[i];
    }

    for(int i=0;i<5;i++) {
        if(vetor[i]>vetor[0]) {
            maior++;
        }
        else if(vetor[i]<vetor[0]) {
            menor++;
        }
        else {
            igual++;
        }
    }

    cout<<"\nMaiores que o primeiro: "<<maior<<endl;
    cout<<"Menores que o primeiro: "<<menor<<endl;
    cout<<"Iguais ao primeiro: "<<igual<<endl;

    return 0;
}
