//Leia dois vetores A e B com vinte elementos. Construa um terceiro vetor C, onde cada
//elemento é a subtração do elemento correspondente de a A com B.

#include <iostream>
using namespace std;

int main() {
    int A[20],B[20],C[20];

    for(int i=0;i<20;i++) {
        cout<<"Digite um valor para A: ";
        cin>>A[i];
    }

    for(int i=0;i<20;i++) {
        cout<<"Digite um valor para B: ";
        cin>>B[i];
    }

    for(int i=0;i<20;i++) {
        C[i]=A[i]-B[i];
    }

    cout<<"\nVetor C:\n";

    for(int i=0;i<20;i++) {
        cout<<C[i]<<endl;
    }

    return 0;
}
